# Environments and build output — reproduced by bootstrap, never committed
.venv/
node_modules/
web/dist/
*.egg-info/
build/                 # setuptools leaves this behind after `pip wheel .`
dist/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Secrets
.env

# Runtime workspace: event logs, SQLite, checkpoints, sandboxes
.evolution/
openevolve_output/

# The source handoff package (inputs, not project source)
.handoff/

.DS_Store
*.log
web/tsconfig.tsbuildinfo

# OE-MAX run outputs
runs/

# OpenCode plugin build output — reproduced by `npm run build` in packages/opencode-plugin
packages/*/dist/

# Scratch stores left by interrupted debugging runs
_tmp_store/
_test15_tmp/
