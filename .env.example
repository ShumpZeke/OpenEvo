# Evolution — environment template. Copy to .env and fill in what you use.
# NEVER commit .env. Only variable NAMES are ever recorded in telemetry.

# --- Primary route: OpenCode Zen -------------------------------------------
# NO KEY IS NEEDED for the free routes. Zen serves nemotron-3-ultra-free,
# hy3-free, laguna-s-2.1-free and nemotron-3.5-lightning-free with no
# Authorization header at all (verified 2026-08-26). A key unlocks the paid
# models on the same endpoint.
#
# Ox Alpha (`x-preview-f-free`) was the primary and has been WITHDRAWN — see
# PROVIDERS.md. Free routes here carry no permanence guarantee; the provider
# doctor probes availability and tool support at runtime rather than trusting
# this file.
OPENCODE_API_KEY=

# --- Strong fallback: NVIDIA NIM -------------------------------------------
# Model ids are catalogue-verified and inference-UNVERIFIED in this repo: no
# key has ever been present. Setting one and running
# `POST /v1/oe-max/verify` on the broker is what turns that into measurement.
NVIDIA_API_KEY=

# --- Catalogue providers (all optional) ------------------------------------
# Declared in configs/oe_max/providers.yaml. Each is key-gated: without its
# variable the provider is inert and never enters a routing chain, so leaving
# every line below empty is a supported configuration.
#
# Model ids are NOT configured for these — they are discovered from each
# provider's own listing, so setting a key is all that is required.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
SAMBANOVA_API_KEY=
MODELSCOPE_API_KEY=
CHUTES_API_KEY=
ZAI_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
NEBIUS_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# --- Other OpenAI-compatible providers (optional) --------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Local OpenAI-compatible endpoint (optional) --------------------------
# EVOLUTION_LOCAL_BASE=http://127.0.0.1:11434/v1
# EVOLUTION_LOCAL_MODEL=qwen2.5-coder

# --- Control plane --------------------------------------------------------
# EVOLUTION_HOST=127.0.0.1
# EVOLUTION_PORT=8000
# EVOLUTION_CLASSIC_PORT=8080
# EVOLUTION_WORKSPACE=./.evolution/workspace
